nk","href":"/DH-V3/experiments/exp-07","label":"Exp 07 - Harder World","docId":"experiments/exp-07","unlisted":false},{"type":"link","href":"/DH-V3/experiments/exp-08","label":"Exp 08 - Aggressive Evolution","docId":"experiments/exp-08","unlisted":false}],"collapsed":true,"collapsible":true}],"collapsed":true,"collapsible":true}]},"docs":{"abstract":{"id":"abstract","title":"Abstract","description":"Donald Hoffman’s Interface Theory of Consciousness posits that perceptual experience is not a window into objective reality, but a species-specific interface shaped by natural selection to maximize fitness, not truth. According to this view, spacetime, objects, and the self are merely “desktop icons”—simplified summaries of hidden structure that guide adaptive behavior, while the underlying reality remains forever inaccessible.","sidebar":"docsSidebar"},"core-concepts":{"id":"core-concepts","title":"Core Concepts","description":"The World (Ground Truth)","sidebar":"docsSidebar"},"experiments":{"id":"experiments","title":"Experiments Overview","description":"This section documents all the experiments conducted with TraceReality. Each experiment tests specific hypotheses about how neural observers learn hidden world structures through evolutionary selection.","sidebar":"docsSidebar"},"experiments/exp-01":{"id":"experiments/exp-01","title":"Exp 01 - Baseline","description":"Research Question","sidebar":"docsSidebar"},"experiments/exp-02":{"id":"experiments/exp-02","title":"Exp 02 - Extended Run","description":"Research Question","sidebar":"docsSidebar"},"experiments/exp-03":{"id":"experiments/exp-03","title":"Exp 03 - Generation Scaling","description":"Research Question","sidebar":"docsSidebar"},"experiments/exp-04":{"id":"experiments/exp-04","title":"Exp 04 - Population Scaling","description":"Research Question","sidebar":"docsSidebar"},"experiments/exp-05":{"id":"experiments/exp-05","title":"Exp 05 - No Evolution Ablation","description":"Research Question","sidebar":"docsSidebar"},"experiments/exp-06":{"id":"experiments/exp-06","title":"Exp 06 - Count-Based Baseline","description":"Research Question","sidebar":"docsSidebar"},"experiments/exp-07":{"id":"experiments/exp-07","title":"Exp 07 - Harder World","description":"Research Question","sidebar":"docsSidebar"},"experiments/exp-08":{"id":"experiments/exp-08","title":"Exp 08 - Aggressive Evolution","description":"Research Question","sidebar":"docsSidebar"},"index":{"id":"index","title":"Welcome","description":"Data drops to whispers, compressed till it clears,Refining the chaos to map out our fears.For a world made of signals is fragile and blind,Until it is stitched in the loom of the mind;And the lines of the matrix hold steady and true,Not by counting the facts, but by shaping the view.","sidebar":"docsSidebar"},"intro":{"id":"intro","title":"intro","description":"---","sidebar":"docsSidebar"},"metrics-reference":{"id":"metrics-reference","title":"Metrics Reference","description":"Primary Metrics","sidebar":"docsSidebar"},"results-interpretation":{"id":"results-interpretation","title":"Results Interpretation","description":"Quick Start: Reading Your First Result","sidebar":"docsSidebar"},"running-experiments":{"id":"running-experiments","title":"Running Experiments","description":"Quick Start","sidebar":"docsSidebar"}}}}